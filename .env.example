# === Configuration Road2Track ===
# Copier ce fichier en `.env` (jamais committé) et remplir les valeurs réelles.
# Voir specs/05-infrastructure.md et ADR-021 pour le contexte.

# --- Temporal ---
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# --- Postgres applicatif ---
POSTGRES_USER=road2track
POSTGRES_PASSWORD=changeme_with_random_value
POSTGRES_DB=road2track
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- MinIO (stockage objet S3-compatible) ---
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=changeme_with_random_value
MINIO_SECRET_KEY=changeme_with_random_value
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_INTERMEDIATES=intermediates
MINIO_BUCKET_OUTPUTS=outputs

# --- NATS (events temps réel) ---
NATS_URL=nats://127.0.0.1:4222

# --- Tailscale (worker GPU sur PC ou cloud) ---
# Auth key réutilisable taguée tag:gpu-worker, à générer sur https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-CHANGEME

# --- RunPod (V1+ pour spillover GPU cloud) ---
RUNPOD_API_KEY=rp_CHANGEME

# --- Worker config ---
TASK_QUEUE=cpu  # cpu | gpu | windows-tools
LOG_LEVEL=INFO
