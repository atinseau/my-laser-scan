{
  "include": ["packages", "services", "scripts"],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/build",
    "**/dist",
    "**/node_modules",
    "packages/ml/src/road2track_ml/gs/checkpoint.py",
    "packages/ml/src/road2track_ml/gs/losses.py",
    "packages/ml/src/road2track_ml/gs/training.py",
    "packages/ml/src/road2track_ml/mesh/extraction.py",
    "packages/ml/src/road2track_ml/texture/baking.py",
    "packages/ac_export/src/road2track_ac_export/uv_unwrap.py",
    "packages/pipeline/src/road2track_pipeline/activities/generate_fbx.py"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "warning",
  "reportUnknownMemberType": "warning",
  "reportUnknownArgumentType": "warning",
  "reportPrivateUsage": "warning",
  "reportImportCycles": "error"
}
